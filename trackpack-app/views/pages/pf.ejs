<div class="two-col">
  <div class="card">
    <div class="card-title"><i class="ti ti-building-factory-2"></i>Nuovo ordine PF</div>
    <form method="POST" action="/pf" id="form-pf">

      <div class="fr">
        <label class="fl">Articolo da produrre <span class="req">*</span></label>
        <select name="articolo_codice" class="fi" id="p-art" onchange="updateLottoPF();document.getElementById('p-art-descr').value=this.options[this.selectedIndex].text" required>
          <option value="">— seleziona —</option>
          <% articoli.forEach(a => { %>
            <option value="<%= a.codice %>"><%= a.codice %> · <%= a.descrizione %></option>
          <% }) %>
        </select>
        <input type="hidden" name="articolo_descrizione" id="p-art-descr">
      </div>

      <div class="g2">
        <div class="fr">
          <label class="fl">Quantità (pz) <span class="req">*</span></label>
          <input type="number" name="quantita" class="fi" id="p-qty" placeholder="0" oninput="updateLottoPF()" required>
        </div>
        <div class="fr">
          <label class="fl">Linea produzione</label>
          <select name="linea" class="fi"><option>Linea A</option><option>Linea B</option></select>
        </div>
      </div>

      <div style="font-size:13px;font-weight:700;margin-bottom:8px;">Lotti MP collegati</div>
      <div class="info-box info-verde"><i class="ti ti-info-circle"></i>La quantità può essere 0 se il lotto è tracciato ma non consumato.</div>
      <div id="pf-mp-rows"></div>
      <div style="display:flex;gap:8px;margin-bottom:14px;">
        <select class="fi" id="pf-mp-select" style="flex:1;font-size:13px;">
          <option value="">Aggiungi lotto MP…</option>
          <% lottiMP.forEach(l => { %>
            <option value="<%= l.codice %>" data-descr="<%= l.materiale_descrizione %>" data-um="<%= l.unita_misura %>" data-giac="<%= l.giacenza %>">
              <%= l.codice %> · <%= l.materiale_descrizione %>
            </option>
          <% }) %>
        </select>
        <button type="button" class="btn btn-verde" onclick="aggiungiPF_MP()"><i class="ti ti-plus"></i>MP</button>
      </div>

      <div style="font-size:13px;font-weight:700;margin-bottom:8px;">Lotti SM collegati</div>
      <div id="pf-sm-rows"></div>
      <div style="display:flex;gap:8px;margin-bottom:14px;">
        <select class="fi" id="pf-sm-select" style="flex:1;font-size:13px;">
          <option value="">Aggiungi lotto SM…</option>
          <% lottiSM.forEach(l => { %>
            <option value="<%= l.codice %>" data-descr="<%= l.tipo_descrizione %>" data-um="<%= l.unita_misura %>" data-giac="<%= l.giacenza %>">
              <%= l.codice %> · <%= l.tipo_descrizione %>
            </option>
          <% }) %>
        </select>
        <button type="button" class="btn btn-primary" style="background:var(--su-violal);border-color:#c5bfee;color:var(--su-viola);" onclick="aggiungiPF_SM()"><i class="ti ti-plus"></i>SM</button>
      </div>

      <div class="lotto-box lb-pf" id="lotto-pf-preview">
        <div class="lotto-label">Lotto PF generato</div>
        <div class="lotto-code">PF-AAAAMMGG-ART-NNN</div>
        <div class="lotto-meta">Seleziona articolo e inserisci quantità</div>
      </div>

      <div class="btn-row">
        <button type="button" class="btn" onclick="openModal('modal-label-pf')"><i class="ti ti-printer"></i>Stampa etichetta PF</button>
        <button type="submit" class="btn btn-amber"><i class="ti ti-player-play"></i>Avvia produzione</button>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="card-title"><i class="ti ti-history"></i>Ordini attivi</div>
    <% if (storico.length === 0) { %>
      <div class="empty"><i class="ti ti-inbox"></i><p>Nessun ordine ancora</p></div>
    <% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Lotto PF</th><th>Articolo</th><th>Qty</th><th>Stato</th></tr></thead>
        <tbody>
          <% storico.forEach(r => { %>
            <tr>
              <td class="mono"><%= r.codice %></td>
              <td><%= r.articolo_descrizione %></td>
              <td><%= (r.quantita||0).toLocaleString('it-IT') %> pz</td>
              <td><span class="pill pill-<%= r.stato==='in_corso'?'verde':r.stato==='attesa'?'amber':r.stato==='completato'?'viola':'grigio' %>"><%= r.stato %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    <% } %>
  </div>
</div>

<!-- MODAL ETICHETTA PF -->
<div class="modal-overlay" id="modal-label-pf">
  <div class="modal" style="max-width:680px;">
    <div class="modal-hdr">
      <span class="modal-title"><i class="ti ti-barcode" style="color:var(--amber);"></i>Etichetta PF — Codici riciclo</span>
      <button class="modal-close" onclick="closeModal('modal-label-pf')"><i class="ti ti-x"></i></button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="riciclo-val" name="riciclo_codici">
