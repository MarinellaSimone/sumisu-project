            <div class="label-legal" id="pf-legal" style="display:none;">
              Verifica le disposizioni del tuo comune.<br>
              <span id="legal-idoneo" style="display:none;">Idoneo al contatto con alimenti DM 21/03/70 e SMI.</span>
            </div>
          </div>
          <div class="btn-row" style="margin-top:12px;">
            <button class="btn" onclick="closeModal('modal-label-pf')">Annulla</button>
            <button class="btn btn-amber" onclick="toast('Etichetta PF inviata alla Zebra','ok');closeModal('modal-label-pf')"><i class="ti ti-printer"></i>Stampa</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function aggiungiPF_MP() {
  const sel = document.getElementById('pf-mp-select')
  if (!sel.value) return
  const opt = sel.options[sel.selectedIndex]
  addLottoRow('pf-mp-rows', 'MP', sel.value, opt.dataset.descr + ' · ' + opt.dataset.giac + ' ' + opt.dataset.um, opt.dataset.um)
  sel.value = ''
}
function aggiungiPF_SM() {
  const sel = document.getElementById('pf-sm-select')
  if (!sel.value) return
  const opt = sel.options[sel.selectedIndex]
  addLottoRow('pf-sm-rows', 'SM', sel.value, opt.dataset.descr + ' · ' + opt.dataset.giac + ' ' + opt.dataset.um, opt.dataset.um)
  sel.value = ''
}
</script>
