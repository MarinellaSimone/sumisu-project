          <div class="riciclo-grid">
            <div class="riciclo-item" id="ric-pap"  onclick="toggleRiciclo('pap')"><div class="riciclo-icon">♻</div><div class="riciclo-label">PAP 21</div><div class="riciclo-sub">Cartone</div></div>
            <div class="riciclo-item" id="ric-ldpe" onclick="toggleRiciclo('ldpe')"><div class="riciclo-icon">♻</div><div class="riciclo-label">LDPE 4</div><div class="riciclo-sub">Polietilene</div></div>
            <div class="riciclo-item" id="ric-pet"  onclick="toggleRiciclo('pet')"><div class="riciclo-icon">♻</div><div class="riciclo-label">PET 1</div><div class="riciclo-sub">Poliestere</div></div>
            <div class="riciclo-item" id="ric-pp"   onclick="toggleRiciclo('pp')"><div class="riciclo-icon">♻</div><div class="riciclo-label">PP 5</div><div class="riciclo-sub">Polipropilene</div></div>
            <div class="riciclo-item" id="ric-alu"  onclick="toggleRiciclo('alu')"><div class="riciclo-icon">♻</div><div class="riciclo-label">ALU</div><div class="riciclo-sub">Alluminio</div></div>
            <div class="riciclo-item" id="ric-gl"   onclick="toggleRiciclo('gl')"><div class="riciclo-icon">♻</div><div class="riciclo-label">GL 70</div><div class="riciclo-sub">Vetro</div></div>
            <div class="riciclo-item" id="ric-c6"   onclick="toggleRiciclo('c6')"><div class="riciclo-icon">♻</div><div class="riciclo-label">C/PAP 6</div><div class="riciclo-sub">Cart. pol.</div></div>
            <div class="riciclo-item" id="ric-fe"   onclick="toggleRiciclo('fe')"><div class="riciclo-icon">♻</div><div class="riciclo-label">FE 40</div><div class="riciclo-sub">Acciaio</div></div>
          </div>
          <div style="font-size:13px;font-weight:700;margin:14px 0 10px;">2. Idoneità alimentare</div>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;padding:10px 12px;border:1.5px solid var(--bdr);border-radius:var(--rad);background:#fff;">
            <input type="checkbox" id="chk-fork" onchange="aggiornaLabelPF()" style="width:18px;height:18px;accent-color:var(--su-viola);">
            <div>
              <div style="font-size:13px;font-weight:600;">🍴 Idoneo al contatto con alimenti</div>
              <div style="font-size:11px;color:var(--grigio);">DM 21/03/70 e SMI</div>
            </div>
          </label>
          <p style="font-size:11px;color:var(--grigio);margin-top:10px;font-style:italic;">"Verifica le disposizioni del tuo comune." è sempre presente.</p>
        </div>
        <div>
          <div style="font-size:13px;font-weight:700;margin-bottom:10px;">Anteprima etichetta</div>
          <div class="label-preview">
            <div class="label-company">DULCIBANA s.r.l.</div>
