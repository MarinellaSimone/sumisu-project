              </g>
            </svg>
            <div class="label-gs1">(01) 05089217109800 (10)20260623<br>(17)20260623 (37)500 (3103) 001001</div>
            <div class="label-row"><span>LOTTO: 20260326</span><span>Q.ty: 500</span></div>
            <div class="label-icons" id="pf-icons-area" style="display:none;">
              <div id="icon-fork-wrap" style="display:none;">
                <svg width="32" height="32" viewBox="0 0 34 34" fill="none" stroke="#333" stroke-width="1.8">
                  <rect x="2" y="2" width="30" height="30" rx="4" fill="none"/>
                  <line x1="11" y1="7" x2="11" y2="19"/><line x1="11" y1="19" x2="17" y2="25"/>
                  <line x1="23" y1="7" x2="23" y2="25"/>
