          </g>
        </svg>
        <div class="label-gs1">(01) 05089217109800 (10)20260623<br>(17)20260623 (37)500 (3103) 001001</div>
        <div class="label-row">
          <span>LOTTO: <span id="mp-lbl-lotto">—</span></span>
          <span>Q.ty: <span id="mp-lbl-qty">—</span></span>
        </div>
      </div>
      <div class="btn-row" style="margin-top:16px;">
        <button class="btn" onclick="closeModal('modal-label-mp')">Annulla</button>
        <button class="btn btn-primary" onclick="toast('Etichetta inviata alla Zebra ZD230','ok');closeModal('modal-label-mp')">
          <i class="ti ti-printer"></i>Stampa
        </button>
      </div>
    </div>
  </div>
</div>

<script>
// Aggiorna select materiale con la descrizione
document.getElementById('r-mat')?.addEventListener('change', function() {
  const opt = this.options[this.selectedIndex]
  document.getElementById('r-mat-descr').value = opt.text
  updateLottoMP()
})
</script>
