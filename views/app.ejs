<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TrackPack</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div id="view-app" style="height:100dvh;display:flex;flex-direction:column;">

  <!-- TOPBAR -->
  <div class="topbar">
    <h1 class="topbar-title" id="page-title">Dashboard</h1>
    <div class="topbar-right">
      <div class="topbar-user">
        <div class="avatar" id="topbar-av"><%= user.nome[0].toUpperCase() %></div>
        <span id="topbar-name"><%= user.nome %></span>
      </div>  
    </div>
  </div>

  <div class="shell">
    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-logo" style="padding:12px 16px;min-height:56px;display:flex;align-items:center;overflow:hidden;white-space:nowrap;">
        <img src="/logo-sumisu.png" style="height:32px;width:auto;" alt="Sumisu">
      </div>
      <nav class="sidebar-nav">
        <div class="nav-section">Operativo</div>
        <a class="nav-item active" onclick="goPage('dash','Dashboard')" id="ni-dash"><i class="ti ti-layout-dashboard"></i><span>Dashboard</span></a>
        <a class="nav-item" onclick="goPage('mp','Ricevimento MP')" id="ni-mp"><i class="ti ti-truck-delivery"></i><span>Ricevimento MP</span></a>
        <a class="nav-item" onclick="goPage('sm','Lavorazione SM')" id="ni-sm"><i class="ti ti-layers-subtract"></i><span>Lavorazione SM</span></a>
        <a class="nav-item" onclick="goPage('pf','Produzione PF')" id="ni-pf"><i class="ti ti-building-factory-2"></i><span>Produzione PF</span></a>
        <a class="nav-item" onclick="goPage('mag','Magazzino')" id="ni-mag"><i class="ti ti-package"></i><span>Magazzino</span></a>
        <div id="nav-admin-section" style="<%= user.ruolo === 'operatore' ? 'display:none;' : '' %>">
          <div class="nav-section">Gestione</div>
          <a class="nav-item" onclick="goPage('sped','Spedizioni PF')" id="ni-sped"><i class="ti ti-truck"></i><span>Spedizioni PF</span></a>
          <a class="nav-item" onclick="goPage('ana','Anagrafiche')" id="ni-ana"><i class="ti ti-address-book"></i><span>Anagrafiche</span></a>
          <a class="nav-item" onclick="goPage('traccia','Rintracciabilità')" id="ni-traccia"><i class="ti ti-git-branch"></i><span>Rintracciabilità</span></a>
          <a class="nav-item" onclick="goPage('utenti','Gestione utenti')" id="ni-utenti"><i class="ti ti-users"></i><span>Gestione utenti</span></a>
        </div>
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-user-info">
          <div class="sb-avatar" id="sb-av"><%= user.nome[0].toUpperCase() %></div>
          <div>
            <div class="sb-username" id="sb-name" style="white-space:nowrap;"><%= user.nome %></div>
            <div class="sb-ruolo"><span class="pill <%= user.ruolo === 'admin' ? 'pill-viola' : 'pill-verde' %>"><%= user.ruolo %></span></div>
          </div>
        </div>
        <button class="logout-btn" onclick="doLogout()"><i class="ti ti-logout"></i><span class="logout-btn-label">Esci</span></button>
      </div>
    </aside>

    <!-- MAIN -->
    <div class="main">
      <div class="page-content">

        <!-- DASHBOARD -->
        <div class="page on" id="page-dash">
          <div class="kpi-grid">
            <div class="kpi-card"><div class="kpi-label">Lotti MP totali</div><div class="kpi-value c-verde" id="kpi-mp">–</div><div class="kpi-sub">in magazzino</div></div>
            <div class="kpi-card"><div class="kpi-label">Lavorazioni SM attive</div><div class="kpi-value c-viola" id="kpi-sm">–</div><div class="kpi-sub">disponibili + in uso</div></div>
            <div class="kpi-card"><div class="kpi-label">Ordini PF in corso</div><div class="kpi-value c-amber" id="kpi-pf">–</div><div class="kpi-sub">in corso + in attesa</div></div>
            <div class="kpi-card kpi-alert"><div class="kpi-label">Lotti sotto soglia</div><div class="kpi-value" style="color:var(--rosso);" id="kpi-soglia">–</div><div class="kpi-sub" style="color:var(--rosso);opacity:.7;">richiedono riordino</div></div>
          </div>
          <div class="alert-banner" id="alert-soglia" style="display:none;">
            <i class="ti ti-alert-triangle"></i>
            <div id="alert-soglia-txt"></div>
            <button onclick="this.parentElement.style.display='none'" style="background:none;border:none;cursor:pointer;color:var(--amber);font-size:18px;margin-left:auto;flex-shrink:0;"><i class="ti ti-x"></i></button>
          </div>
          <div class="two-col">
            <div class="card">
              <div class="card-title"><i class="ti ti-activity"></i>Ultimi movimenti</div>
              <div id="dash-movimenti"><div class="empty"><i class="ti ti-inbox"></i><p>Nessun movimento</p></div></div>
            </div>
            <div class="card">
              <div class="card-title"><i class="ti ti-building-factory-2"></i>Ordini PF attivi</div>
              <div class="tw"><table><thead><tr><th>Lotto PF</th><th>Articolo</th><th>Qty</th><th>Stato</th></tr></thead><tbody id="dash-ordini"></tbody></table></div>
            </div>
          </div>
          </div>

        <!-- RICEVIMENTO MP -->
        <div class="page" id="page-mp">
          <div class="two-col">
            <div class="card">
              <div class="card-title"><i class="ti ti-truck-delivery"></i>Nuovo ricevimento</div>
              <div class="fr"><label class="fl">Fornitore</label><select class="fi" id="mp-fornitore"></select></div>
              <div class="fr"><label class="fl">Materiale MP <span class="req">*</span></label><select class="fi" id="mp-materiale"></select></div>
              <div class="g3">
                <div class="fr"><label class="fl">N° DDT / Fattura <span class="req">*</span></label><input class="fi" type="text" id="mp-ddt" placeholder="es. 2026/0445"></div>
                <div class="fr"><label class="fl">Data DDT <span class="req">*</span></label><input class="fi" type="date" id="mp-data"></div>
                <div class="fr"><label class="fl">Quantità <span class="req">*</span></label><div style="display:flex;gap:6px;"><input class="fi" type="number" id="mp-qty" placeholder="0" style="flex:1;"><select class="fi" id="mp-um" style="width:70px;padding:11px 6px;"><option>kg</option><option>mq</option><option>pz</option><option>mt</option></select></div></div>
              </div>
              <div class="fr"><label class="fl">N° pedane</label><input class="fi" type="number" id="mp-ped" value="1"></div>
              <div class="fr"><label class="fl">Note</label><textarea class="fi" id="mp-note" placeholder="es. 2 pedane danneggiate…"></textarea></div>
              <div class="btn-row">
                <button class="btn btn-primary" onclick="salvaMP(this)"><i class="ti ti-check"></i>Stampa Etichetta</button>
              </div>
            </div>
            <div class="card">
              <div class="card-title"><i class="ti ti-history"></i>Storico ricevimenti</div>
              <div class="tw"><table><thead><tr><th>Lotto MP</th><th>Materiale</th><th>Data</th><th>Giacenza</th><th>Stato</th></tr></thead><tbody id="mp-storico"></tbody></table></div>
            </div>
            <div id="label-mp" class="label-modal"></div>
          </div>
        </div>

        <!-- LAVORAZIONE SM -->
        <div class="page" id="page-sm">
          <div class="two-col">
            <div class="card">
              <div class="card-title"><i class="ti ti-layers-subtract"></i>Nuova lavorazione SM</div>
              <div class="fr"><label class="fl">Tipo lavorazione <span class="req">*</span></label>
                <div style="display:flex;border:1.5px solid var(--bdr);border-radius:var(--rad);overflow:hidden;">
                  <button class="tab-btn on" style="border-radius:0;" id="sm-int" onclick="setSMTipo('int')">🏭 Interna</button>
                  <button class="tab-btn" style="border-radius:0;border-left:1px solid var(--bdr);" id="sm-ext" onclick="setSMTipo('ext')">🚛 Esterna</button>
                </div>
              </div>
              <div id="sm-ext-box" style="display:none;background:var(--bg);border:1px solid var(--bdr);border-radius:var(--rad);padding:14px;margin:14px 0;">
                <div class="g3">
                  <div class="fr" style="margin-bottom:0;"><label class="fl">Fornitore SM</label><select class="fi" id="sm-fornitore"><option value="">— nessuno —</option></select></div>
                  <div class="fr" style="margin-bottom:0;"><label class="fl">N° DDT</label><input class="fi" type="text" id="sm-ddt"></div>
                  <div class="fr" style="margin-bottom:0;"><label class="fl">Data DDT</label><input class="fi" type="date" id="sm-ddt-data"></div>
                </div>
              </div>
              <div class="fr"><label class="fl">Tipo semilavorato <span class="req">*</span></label><select class="fi" id="sm-tipo"></select></div>
              <div class="g2">
                <div class="fr"><label class="fl">Quantità <span class="req">*</span></label><div style="display:flex;gap:6px;"><input class="fi" type="number" id="sm-qty" value="0" style="flex:1;"><select class="fi" id="sm-um" style="width:70px;padding:11px 6px;"><option>kg</option><option>mq</option><option>pz</option><option>mt</option></select></div></div>
                <div class="fr"><label class="fl">Data lavorazione</label><input class="fi" type="date" id="sm-data"></div>
              </div>
              <div style="font-size:13px;font-weight:700;margin-bottom:8px;">Lotti MP utilizzati</div>
              <div id="sm-lot-add-tabs" class="tabs" style="margin-bottom:10px;">
                <button class="tab-btn on" onclick="smLotAddTab('manual',this)">Manuale</button>
                <button class="tab-btn" onclick="smLotAddTab('scanner',this)">Scannerizza</button>
              </div>
              <div id="sm-mp-rows"></div>
              <div id="sm-mp-manual" style="display:block;">
                <div style="display:flex;gap:8px;margin-bottom:14px;">
                  <select class="fi" id="sm-mp-sel" style="flex:1;font-size:13px;"><option value="">Aggiungi lotto MP…</option></select>
                  <button class="btn btn-verde" onclick="addSMConsumo()"><i class="ti ti-plus"></i></button>
                </div>
              </div>
              <div id="sm-mp-scanner" style="display:none;">
                <div class="fr" style="margin-bottom:0;">
                  <label class="fl">Barcode scannerizzato</label>
                  <input class="fi" id="sm-mp-scan" placeholder="Incolla / scannerizza il valore barcode" onkeydown="if(event.key==='Enter') addSMConsumoByScan()">
                </div>
                <div style="display:flex;justify-content:flex-start;gap:8px;margin-top:8px;">
                  <button class="btn btn-verde" onclick="addSMConsumoByScan()"><i class="ti ti-scan"></i>Recupera lotto</button>
                </div>
              </div>
              <div class="fr"><label class="fl">Note</label><textarea class="fi" id="sm-note"></textarea></div>
              <div class="btn-row"><button class="btn btn-primary" onclick="salvaSM(this)"><i class="ti ti-check"></i>Conferma SM</button></div>
            </div>
            <div class="card">
              <div class="card-title"><i class="ti ti-history"></i>Storico lavorazioni</div>
              <div class="tw"><table><thead><tr><th>Lotto SM</th><th>Tipo</th><th>Lav.</th><th>Giacenza</th><th>Stato</th></tr></thead><tbody id="sm-storico"></tbody></table></div>
            </div>
            <div id="label-sm" class="label-modal"></div>
          </div>
        </div>

        <!-- PRODUZIONE PF -->
        <div class="page" id="page-pf">
          <div class="two-col">
            <div class="card">
              <div class="card-title"><i class="ti ti-building-factory-2"></i>Nuovo ordine PF</div>
              <div class="fr"><label class="fl">Articolo da produrre <span class="req">*</span></label><select class="fi" id="pf-art"></select></div>
              <div class="fr"><label class="fl">Quantità <span class="req">*</span></label><div style="display:flex;gap:6px;"><input class="fi" type="number" id="pf-qty" value="0" style="flex:1;"><select class="fi" id="pf-um" style="width:70px;padding:11px 6px;"><option>kg</option><option>mq</option><option>pz</option><option>mt</option></select></div></div>
              <div class="fr"><label class="fl">Data produzione</label><input class="fi" type="date" id="pf-data"></div>
              <div style="font-size:13px;font-weight:700;margin-bottom:8px;">Lotti MP collegati</div>
              <div id="pf-mp-add-tabs" class="tabs" style="margin-bottom:10px;">
                <button class="tab-btn on" onclick="pfLotAddTab('mp','manual',this)">Manuale</button>
                <button class="tab-btn" onclick="pfLotAddTab('mp','scanner',this)">Scannerizza</button>
              </div>
              <div class="info-box info-verde"><i class="ti ti-info-circle"></i>La quantità può essere 0 se il lotto è tracciato ma non consumato.</div>
              <div id="pf-mp-rows"></div>
              <div id="pf-mp-manual" style="display:block;">
                <div style="display:flex;gap:8px;margin-bottom:14px;">
                  <select class="fi" id="pf-mp-sel" style="flex:1;font-size:13px;"><option value="">Aggiungi lotto MP…</option></select>
                  <button class="btn btn-verde" onclick="addPFConsumoMP()"><i class="ti ti-plus"></i></button>
                </div>
              </div>
              <div id="pf-mp-scanner" style="display:none;">
                <div class="fr" style="margin-bottom:0;">
                  <label class="fl">Barcode scannerizzato</label>
                  <input class="fi" id="pf-mp-scan" placeholder="Incolla / scannerizza il valore barcode" onkeydown="if(event.key==='Enter') addPFConsumoMPByScan()">
                </div>
                <div style="display:flex;justify-content:flex-start;gap:8px;margin-top:8px;">
                  <button class="btn btn-verde" onclick="addPFConsumoMPByScan()"><i class="ti ti-scan"></i>Recupera lotto</button>
                </div>
              </div>
              <div style="font-size:13px;font-weight:700;margin-bottom:8px;">Lotti SM collegati</div>
              <div id="pf-sm-add-tabs" class="tabs" style="margin-bottom:10px;">
                <button class="tab-btn on" onclick="pfLotAddTab('sm','manual',this)">Manuale</button>
                <button class="tab-btn" onclick="pfLotAddTab('sm','scanner',this)">Scannerizza</button>
              </div>
              <div id="pf-sm-rows"></div>
              <div id="pf-sm-manual" style="display:block;">
                <div style="display:flex;gap:8px;margin-bottom:14px;">
                  <select class="fi" id="pf-sm-sel" style="flex:1;font-size:13px;"><option value="">Aggiungi lotto SM…</option></select>
                  <button class="btn btn-primary" style="background:var(--violal);border-color:#c5bfee;color:var(--viola);" onclick="addPFConsumoSM()"><i class="ti ti-plus"></i>SM</button>
                </div>
              </div>
              <div id="pf-sm-scanner" style="display:none;">
                <div class="fr" style="margin-bottom:0;">
                  <label class="fl">Barcode scannerizzato</label>
                  <input class="fi" id="pf-sm-scan" placeholder="Incolla / scannerizza il valore barcode" onkeydown="if(event.key==='Enter') addPFConsumoSMByScan()">
                </div>
                <div style="display:flex;justify-content:flex-start;gap:8px;margin-top:8px;">
                  <button class="btn btn-primary" style="background:var(--violal);border-color:#c5bfee;color:var(--viola);" onclick="addPFConsumoSMByScan()"><i class="ti ti-scan"></i>Recupera lotto</button>
                </div>
              </div>
              <div class="btn-row"><button class="btn btn-amber" onclick="salvaPF(this)"><i class="ti ti-player-play"></i>Avvia produzione</button></div>
            </div>
            <div class="card">
              <div class="card-title"><i class="ti ti-history"></i>Ordini attivi</div>
              <div class="tw"><table><thead><tr><th>Lotto PF</th><th>Articolo</th><th>Qty</th><th>Stato</th></tr></thead><tbody id="pf-storico"></tbody></table></div>
            </div>
          </div>
          <div id="label-pf" class="label-modal"></div>
        </div>

        <!-- MAGAZZINO -->
        <div class="page" id="page-mag">
          <div class="card">
            <div class="card-title"><i class="ti ti-package"></i>Magazzino</div>
            <div class="tabs">
              <button class="tab-btn on" onclick="magTab('mp',this)">MP</button>
              <button class="tab-btn" onclick="magTab('sm',this)">SM</button>
              <button class="tab-btn" onclick="magTab('pf',this)">PF</button>
            </div>
            <div class="tw"><table><thead><tr><th>Lotto</th><th>Descrizione</th><th>Giacenza</th><th>Stato</th></tr></thead><tbody id="mag-body"></tbody></table></div>
          </div>
        </div>

        <!-- SPEDIZIONI -->
        <div class="page" id="page-sped">
          <div class="two-col">
            <div class="card">
              <div class="card-title"><i class="ti ti-truck"></i>Spedizioni PF</div>
              <div class="fr"><label class="fl">Cliente <span class="req">*</span></label><select class="fi" id="sped-cliente"><option value="">— seleziona cliente —</option></select></div>
              <div class="g2">
                <div class="fr"><label class="fl">Data spedizione</label><input class="fi" type="date" id="sped-data"></div>
                <div class="fr"><label class="fl">Vettore</label><input class="fi" type="text" id="sped-vettore" placeholder="es. BRT"></div>
              </div>
              <div style="font-size:13px;font-weight:700;margin-bottom:8px;">Lotti PF da spedire</div>
              <div id="sped-pf-add-tabs" class="tabs" style="margin-bottom:10px;">
                <button class="tab-btn on" onclick="spedLotAddTab('manual',this)">Manuale</button>
                <button class="tab-btn" onclick="spedLotAddTab('scanner',this)">Scannerizza</button>
              </div>
              <div id="sped-pf-rows"></div>
              <div id="sped-pf-manual" style="display:block;">
                <div style="display:flex;gap:8px;margin-bottom:14px;">
                  <select class="fi" id="sped-pf-sel" style="flex:1;font-size:13px;"><option value="">Aggiungi lotto PF…</option></select>
                  <button class="btn btn-verde" onclick="addSpedRiga()"><i class="ti ti-plus"></i></button>
                </div>
              </div>
              <div id="sped-pf-scanner" style="display:none;">
                <div class="fr" style="margin-bottom:0;">
                  <label class="fl">Barcode scannerizzato</label>
                  <input class="fi" id="sped-pf-scan" placeholder="Incolla / scannerizza il valore barcode" onkeydown="if(event.key==='Enter') addSpedRigaByScan()">
                </div>
                <div style="display:flex;justify-content:flex-start;gap:8px;margin-top:8px;">
                  <button class="btn btn-verde" onclick="addSpedRigaByScan()"><i class="ti ti-scan"></i>Recupera lotto</button>
                </div>
              </div>
              <div class="fr"><label class="fl">Note</label><textarea class="fi" id="sped-note"></textarea></div>
              <div class="btn-row"><button class="btn btn-primary" onclick="salvaSped(this)"><i class="ti ti-check"></i>Conferma spedizione</button></div>
            </div>
            <div class="card">
              <div class="card-title"><i class="ti ti-history"></i>Storico DDT</div>
              <div class="tw"><table><thead><tr><th>N° DDT</th><th>Cliente</th><th>Data</th><th>Stato</th></tr></thead><tbody id="sped-storico"></tbody></table></div>
            </div>
          </div>
        </div>

        <!-- ANAGRAFICHE -->
        <div class="page" id="page-ana">
          <div class="tabs">
            <button class="tab-btn on" onclick="anaTab('f',this)">Fornitori</button>
            <button class="tab-btn" onclick="anaTab('c',this)">Clienti</button>
            <button class="tab-btn" onclick="anaTab('m',this)">Materiali MP/SM</button>
            <button class="tab-btn" onclick="anaTab('a',this)">Articoli PF</button>
            <button class="tab-btn" onclick="anaTab('t',this)">Codici tipologie</button>
          </div>
          <!-- Fornitori -->
          <div id="ana-f" class="two-col">
            <div class="card"><div class="card-title"><i class="ti ti-address-book"></i>Fornitori</div>
              <div class="tw"><table><thead><tr><th>Ragione sociale</th><th>P.IVA</th><th>Stato</th></tr></thead><tbody id="ana-f-body"></tbody></table></div>
            </div>
            <div class="card"><div class="card-title">Aggiungi fornitore</div>
              <div class="fr"><label class="fl">Ragione sociale <span class="req">*</span></label><input class="fi" id="af-nome"></div>
              <div class="fr"><label class="fl">P.IVA</label><input class="fi" id="af-piva" placeholder="IT…"></div>
              <div class="fr"><label class="fl">Stato</label><select class="fi" id="af-stato"><option>Attivo</option><option>Sospeso</option></select></div>
              <div class="btn-row"><button class="btn btn-primary" onclick="addFornitore(this)"><i class="ti ti-plus"></i>Aggiungi</button></div>
            </div>
          </div>
          <!-- Clienti -->
          <div id="ana-c" style="display:none;" class="two-col">
            <div class="card"><div class="card-title"><i class="ti ti-users"></i>Clienti</div>
              <div class="tw"><table><thead><tr><th>Ragione sociale</th><th>P.IVA</th><th>Email</th><th>Stato</th></tr></thead><tbody id="ana-c-body"></tbody></table></div>
            </div>
            <div class="card"><div class="card-title">Aggiungi cliente</div>
              <div class="fr"><label class="fl">Ragione sociale <span class="req">*</span></label><input class="fi" id="ac-nome"></div>
              <div class="fr"><label class="fl">P.IVA</label><input class="fi" id="ac-piva" placeholder="IT…"></div>
              <div class="g2"><div class="fr"><label class="fl">Email</label><input class="fi" id="ac-email" type="email"></div><div class="fr"><label class="fl">Telefono</label><input class="fi" id="ac-tel"></div></div>
              <div class="fr"><label class="fl">Stato</label><select class="fi" id="ac-stato"><option>Attivo</option><option>Sospeso</option></select></div>
              <div class="btn-row"><button class="btn btn-primary" onclick="addCliente(this)"><i class="ti ti-plus"></i>Aggiungi</button></div>
            </div>
          </div>
          <!-- Materiali -->
          <div id="ana-m" style="display:none;" class="two-col">
            <div class="card"><div class="card-title">Materiali MP / SM</div>
              <div class="tw"><table><thead><tr><th>Codice</th><th>Codice numerico</th><th>Descrizione</th><th>Tipo</th><th>U.M.</th></tr></thead><tbody id="ana-m-body"></tbody></table></div>
            </div>
            <div class="card"><div class="card-title">Aggiungi materiale</div>
              <div class="g2"><div class="fr"><label class="fl">Codice <span class="req">*</span></label><input class="fi" id="am-cod" maxlength="4" pattern="[A-Za-z0-9]{4}" placeholder="es. FILM"></div><div class="fr"><label class="fl">Codice numerico <span class="req">*</span></label><input class="fi" id="am-cod-num" maxlength="4" inputmode="numeric" pattern="[0-9]{4}" placeholder="es. 0001"></div></div>
              <div class="fr"><label class="fl">Tipo</label><select class="fi" id="am-tipo" onchange="updateMaterialCodeSuggestion()"><option>MP</option><option>SM</option></select></div>
              <div class="fr"><label class="fl">Descrizione <span class="req">*</span></label><input class="fi" id="am-desc"></div>
              <div class="g2">
                <div class="fr"><label class="fl">Quantità minima</label><input class="fi" type="number" id="am-soglia" value="0"></div>
                <div class="fr"><label class="fl">Unità misura</label><select class="fi" id="am-um"><option>kg</option><option>pz</option><option>mq</option><option>mt</option></select></div>
              </div>
              <div class="btn-row"><button class="btn btn-primary" onclick="addMateriale(this)"><i class="ti ti-plus"></i>Aggiungi</button></div>
            </div>
          </div>
          <!-- Articoli -->
          <div id="ana-a" style="display:none;" class="two-col">
            <div class="card"><div class="card-title">Articoli PF</div>
              <div class="tw"><table><thead><tr><th>Codice</th><th>Codice numerico</th><th>Descrizione</th><th>GTIN-14</th><th>Stato</th></tr></thead><tbody id="ana-a-body"></tbody></table></div>
            </div>
            <div class="card"><div class="card-title">Aggiungi articolo PF</div>
              <div class="g2"><div class="fr"><label class="fl">Codice <span class="req">*</span></label><input class="fi" id="aa-cod" maxlength="4" pattern="[A-Za-z0-9]{4}" placeholder="SC03"></div><div class="fr"><label class="fl">Codice numerico <span class="req">*</span></label><input class="fi" id="aa-cod-num" maxlength="4" inputmode="numeric" pattern="[0-9]{4}" placeholder="es. 0001"></div></div>
              <div class="fr"><label class="fl">GTIN-14</label><input class="fi" id="aa-gtin" maxlength="14" inputmode="numeric" pattern="[0-9]{14}" placeholder="es. 09788423400123"></div>
              <div class="fr"><label class="fl">Descrizione <span class="req">*</span></label><input class="fi" id="aa-desc"></div>
              <div class="fr"><label class="fl">Stato</label><select class="fi" id="aa-stato"><option>Attivo</option><option>Bozza</option></select></div>
              <div class="btn-row"><button class="btn btn-primary" onclick="addArticolo(this)"><i class="ti ti-plus"></i>Aggiungi</button></div>
            </div>
          </div>
          <!-- Codici tipologie -->
          <div id="ana-t" style="display:none;">
            <div class="card">
              <div class="card-title"><i class="ti ti-list-numbers"></i>Codici tipologie</div>
              <div class="tw"><table><thead id="ana-t-head"></thead><tbody id="ana-t-body"></tbody></table></div>
            </div>
          </div>
        </div>

        <!-- RINTRACCIABILITÀ -->
        <div class="page" id="page-traccia">
          <div class="card" style="max-width:620px;">
            <div class="card-title"><i class="ti ti-git-branch"></i>Ricerca rintracciabilità</div>
            <p style="font-size:13px;color:var(--grigio);margin-bottom:14px;">Inserisci un codice lotto (LT-, SM- o PF-) per ricostruire la catena completa.</p>
            <div class="fr"><label class="fl">Codice lotto</label><input class="fi" id="trace-in" placeholder="es. LT-20260707-CAR-001" style="font-family:'SF Mono',monospace;" onkeydown="if(event.key==='Enter')doTrace()"></div>
            <div style="display:flex;gap:10px;"><button class="btn btn-danger" onclick="doTrace()"><i class="ti ti-search"></i>Traccia catena completa</button></div>
          </div>
          <div id="trace-res" style="display:none;margin-top:16px;">
            <div class="card" style="border-color:#f7c1c1;">
              <div style="font-size:14px;font-weight:700;color:var(--rosso);margin-bottom:10px;"><i class="ti ti-git-branch"></i> Catena · <span id="trace-title" class="mono"></span></div>
              <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;" id="trace-chain"></div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;">
              <div class="card" style="padding:0;overflow:hidden;"><div style="padding:10px 14px;font-size:12px;font-weight:700;background:var(--verdel);color:var(--violad);border-bottom:1px solid var(--bdr);">Materie prime</div><div class="tw"><table><thead><tr><th>Lotto</th><th>Materiale</th><th>Fornitore</th></tr></thead><tbody id="trace-mp"></tbody></table></div></div>
              <div class="card" style="padding:0;overflow:hidden;"><div style="padding:10px 14px;font-size:12px;font-weight:700;background:var(--violal);color:var(--viola);border-bottom:1px solid var(--bdr);">SM lavorazioni</div><div class="tw"><table><thead><tr><th>Lotto</th><th>Tipo</th><th>Lav.</th></tr></thead><tbody id="trace-sm"></tbody></table></div></div>
              <div class="card" style="padding:0;overflow:hidden;"><div style="padding:10px 14px;font-size:12px;font-weight:700;background:var(--amberl);color:var(--amber);border-bottom:1px solid var(--bdr);">Destinazioni</div><div class="tw"><table><thead><tr><th>PF</th><th>DDT</th><th>Cliente</th></tr></thead><tbody id="trace-pf"></tbody></table></div></div>
            </div>
          </div>
        </div>

        <!-- GESTIONE UTENTI -->
        <div class="page" id="page-utenti">
          <div class="two-col">
            <div class="card">
              <div class="card-title"><i class="ti ti-users"></i>Utenti registrati</div>
              <div class="tw"><table><thead><tr><th>Username</th><th>Nome</th><th>Ruolo</th><th>Stato</th><th>Azioni</th></tr></thead><tbody id="utenti-body"></tbody></table></div>
            </div>
            <div class="card">
              <div class="card-title"><i class="ti ti-user-plus"></i>Aggiungi utente</div>
              <div class="fr"><label class="fl">Username <span class="req">*</span></label><input class="fi" id="nu-user" placeholder="es. operatore3"><div style="font-size:11px;color:#bbb;margin-top:4px;">Minuscolo, senza spazi</div></div>
              <div class="fr"><label class="fl">Nome completo</label><input class="fi" id="nu-nome" placeholder="es. Giovanni Bianchi"></div>
              <div class="fr"><label class="fl">Ruolo <span class="req">*</span></label><select class="fi" id="nu-ruolo"><option value="operatore">Operatore — MP, SM, PF, Magazzino</option><option value="admin">Admin — accesso completo</option></select></div>
              <div class="fr"><label class="fl">Password <span class="req">*</span></label><input class="fi" type="password" id="nu-pw" placeholder="Min. 6 caratteri"></div>
              <div class="info-box info-verde"><i class="ti ti-info-circle"></i>L'operatore accede a MP, SM, PF e Magazzino. Non vede Spedizioni, Anagrafiche e Rintracciabilità.</div>
              <div class="btn-row"><button class="btn btn-primary" onclick="addUtente(this)"><i class="ti ti-user-plus"></i>Crea utente</button></div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<div class="loading-overlay" id="loading-overlay" style="display:none;"><div class="loading-box"><div class="spinner"></div><span id="loading-msg">Salvataggio…</span></div></div>

<script>
  window.__USER__ = <%- JSON.stringify(user) %>;
</script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
