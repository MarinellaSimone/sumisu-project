<form class="auth-form" method="POST" action="/login">
  <div class="fr">
    <label class="fl" for="username">Nome utente</label>
    <input id="username" name="username" type="text" class="fi" autocomplete="username" required>
  </div>
  <div class="fr">
    <label class="fl" for="password">Password</label>
    <input id="password" name="password" type="password" class="fi" autocomplete="current-password" required>
  </div>
  <div class="btn-row">
    <button type="submit" class="btn btn-primary">Accedi</button>
  </div>
</form>
