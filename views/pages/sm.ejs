      <span class="modal-title"><i class="ti ti-barcode" style="color:var(--su-viola);"></i>Etichetta SM</span>
      <button class="modal-close" onclick="closeModal('modal-label-sm')"><i class="ti ti-x"></i></button>
    </div>
    <div class="modal-body">
      <div class="label-preview" style="max-width:360px;">
        <div class="label-company">DULCIBANA s.r.l.</div>
        <svg width="320" height="75" viewBox="0 0 320 75" style="display:block;margin:0 auto;">
          <rect width="320" height="75" fill="white"/>
          <g fill="black">
            <rect x="8" y="0" width="2" height="70"/><rect x="13" y="0" width="4" height="70"/><rect x="20" y="0" width="1" height="70"/><rect x="24" y="0" width="3" height="70"/><rect x="30" y="0" width="2" height="70"/><rect x="35" y="0" width="4" height="70"/><rect x="42" y="0" width="1" height="70"/><rect x="46" y="0" width="2" height="70"/><rect x="51" y="0" width="4" height="70"/><rect x="58" y="0" width="3" height="70"/><rect x="64" y="0" width="1" height="70"/><rect x="68" y="0" width="2" height="70"/><rect x="73" y="0" width="4" height="70"/><rect x="80" y="0" width="1" height="70"/><rect x="84" y="0" width="3" height="70"/><rect x="90" y="0" width="2" height="70"/><rect x="95" y="0" width="4" height="70"/><rect x="102" y="0" width="1" height="70"/><rect x="106" y="0" width="3" height="70"/><rect x="112" y="0" width="2" height="70"/><rect x="117" y="0" width="1" height="70"/><rect x="121" y="0" width="4" height="70"/><rect x="128" y="0" width="2" height="70"/><rect x="133" y="0" width="3" height="70"/><rect x="139" y="0" width="1" height="70"/><rect x="143" y="0" width="2" height="70"/><rect x="148" y="0" width="4" height="70"/><rect x="155" y="0" width="3" height="70"/><rect x="161" y="0" width="1" height="70"/><rect x="165" y="0" width="4" height="70"/><rect x="172" y="0" width="2" height="70"/><rect x="177" y="0" width="1" height="70"/><rect x="181" y="0" width="3" height="70"/><rect x="187" y="0" width="2" height="70"/><rect x="192" y="0" width="4" height="70"/><rect x="199" y="0" width="1" height="70"/><rect x="203" y="0" width="3" height="70"/><rect x="209" y="0" width="2" height="70"/><rect x="214" y="0" width="4" height="70"/><rect x="221" y="0" width="1" height="70"/><rect x="225" y="0" width="2" height="70"/><rect x="230" y="0" width="3" height="70"/><rect x="236" y="0" width="4" height="70"/><rect x="243" y="0" width="1" height="70"/><rect x="247" y="0" width="3" height="70"/><rect x="253" y="0" width="2" height="70"/><rect x="258" y="0" width="1" height="70"/><rect x="262" y="0" width="4" height="70"/><rect x="269" y="0" width="2" height="70"/><rect x="274" y="0" width="3" height="70"/><rect x="280" y="0" width="1" height="70"/><rect x="284" y="0" width="4" height="70"/><rect x="291" y="0" width="2" height="70"/><rect x="296" y="0" width="3" height="70"/>
          </g>
        </svg>
        <div class="label-gs1">(01) 05089217109800 (10)SM20260611<br>(17)20260611 (37)3000</div>
        <div class="label-row">
          <span>LOTTO: SM-20260611-SCT-001</span>
          <span>Q.ty: 3.000 pz</span>
        </div>
      </div>
      <div class="btn-row" style="margin-top:14px;">
        <button class="btn" onclick="closeModal('modal-label-sm')">Annulla</button>
        <button class="btn btn-primary" onclick="toast('Etichetta SM inviata alla Zebra','ok');closeModal('modal-label-sm')"><i class="ti ti-printer"></i>Stampa</button>
      </div>
    </div>
  </div>
</div>

<script>
function aggiungiMP() {
  const sel = document.getElementById('mp-select')
  if (!sel.value) return
  const opt = sel.options[sel.selectedIndex]
  addLottoRow('sm-mp-rows', 'MP', sel.value, opt.dataset.descr + ' · ' + opt.dataset.giac + ' ' + opt.dataset.um + ' disp.', opt.dataset.um)
  sel.value = ''
}
function aggiungiMPScan() {
  const v = document.getElementById('mp-scan-input')?.value.trim()
  if (!v) return
  addLottoRow('sm-mp-rows', 'MP', v, 'Inserimento manuale', 'kg')
  document.getElementById('mp-scan-input').value = ''
}
</script>
