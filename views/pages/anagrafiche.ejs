<% const tab = typeof query !== 'undefined' ? (query.tab||'fornitori') : 'fornitori' %>
<div class="tabs">
  <button class="tab-btn <%= tab==='fornitori'?'on':'' %>" onclick="switchTab('ana','fornitori')">Fornitori</button>
  <button class="tab-btn <%= tab==='materiali'?'on':'' %>" onclick="switchTab('ana','materiali')">Materiali MP/SM</button>
  <button class="tab-btn <%= tab==='articoli'?'on':'' %>" onclick="switchTab('ana','articoli')">Articoli PF</button>
</div>

<!-- FORNITORI -->
<div data-tab-panel="ana" data-panel="fornitori" <%= tab!=='fornitori'?'style="display:none;"':'' %>>
  <div class="two-col">
    <div class="card">
      <div class="card-title"><i class="ti ti-address-book"></i>Fornitori</div>
      <div class="table-wrap"><table>
        <thead><tr><th>Ragione sociale</th><th>P.IVA</th><th>Stato</th></tr></thead>
        <tbody>
          <% fornitori.forEach(f => { %><tr><td><%= f.ragione_sociale %></td><td class="mono"><%= f.piva %></td><td><span class="pill pill-<%= f.stato==='attivo'?'verde':'amber' %>"><%= f.stato %></span></td></tr><% }) %>
          <% if(fornitori.length===0){ %><tr><td colspan="3" style="text-align:center;color:#bbb;font-style:italic;padding:16px;">Nessun fornitore</td></tr><% } %>
        </tbody>
      </table></div>
    </div>
    <div class="card">
      <div class="card-title">Aggiungi fornitore</div>
      <form method="POST" action="/anagrafiche/fornitori">
        <div class="fr"><label class="fl">Ragione sociale <span class="req">*</span></label><input type="text" name="ragione_sociale" class="fi" required></div>
        <div class="fr"><label class="fl">P.IVA</label><input type="text" name="piva" class="fi" placeholder="IT…"></div>
        <div class="fr"><label class="fl">Stato</label><select name="stato" class="fi"><option value="attivo">Attivo</option><option value="sospeso">Sospeso</option></select></div>
        <div class="btn-row"><button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i>Aggiungi</button></div>
      </form>
    </div>
  </div>
</div>

<!-- MATERIALI -->
<div data-tab-panel="ana" data-panel="materiali" style="display:none;">
  <div class="two-col">
    <div class="card">
      <div class="card-title">Materiali MP / SM</div>
      <div class="table-wrap"><table>
        <thead><tr><th>Codice</th><th>Descrizione</th><th>Tipo</th><th>U.M.</th></tr></thead>
        <tbody>
          <% materiali.forEach(m => { %><tr><td class="mono"><%= m.codice %></td><td><%= m.descrizione %></td><td><span class="pill pill-<%= m.tipo==='MP'?'verde':'viola' %>"><%= m.tipo %></span></td><td><%= m.unita_misura %></td></tr><% }) %>
          <% if(materiali.length===0){ %><tr><td colspan="4" style="text-align:center;color:#bbb;font-style:italic;padding:16px;">Nessun materiale</td></tr><% } %>
        </tbody>
      </table></div>
    </div>
    <div class="card">
      <div class="card-title">Aggiungi materiale</div>
      <form method="POST" action="/anagrafiche/materiali">
        <div class="g2">
          <div class="fr"><label class="fl">Codice <span class="req">*</span></label><input type="text" name="codice" class="fi" style="text-transform:uppercase;" required></div>
          <div class="fr"><label class="fl">Tipo</label><select name="tipo" class="fi"><option>MP</option><option>SM</option></select></div>
        </div>
        <div class="fr"><label class="fl">Descrizione <span class="req">*</span></label><input type="text" name="descrizione" class="fi" required></div>
        <div class="fr"><label class="fl">Unità di misura</label><select name="unita_misura" class="fi"><option>kg</option><option>pz</option><option>mq</option><option>mt</option><option>litri</option></select></div>
        <div class="btn-row"><button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i>Aggiungi</button></div>
      </form>
    </div>
  </div>
</div>

<!-- ARTICOLI PF -->
<div data-tab-panel="ana" data-panel="articoli" style="display:none;">
  <div class="two-col">
    <div class="card">
      <div class="card-title">Articoli PF</div>
      <div class="table-wrap"><table>
        <thead><tr><th>Codice</th><th>Descrizione</th><th>GTIN-14</th><th>Stato</th></tr></thead>
        <tbody>
          <% articoli.forEach(a => { %><tr><td class="mono"><%= a.codice %></td><td><%= a.descrizione %></td><td class="mono"><%= a.gtin14 %></td><td><span class="pill pill-<%= a.stato==='attivo'?'verde':'amber' %>"><%= a.stato %></span></td></tr><% }) %>
          <% if(articoli.length===0){ %><tr><td colspan="4" style="text-align:center;color:#bbb;font-style:italic;padding:16px;">Nessun articolo</td></tr><% } %>
        </tbody>
      </table></div>
    </div>
    <div class="card">
      <div class="card-title">Aggiungi articolo PF</div>
      <form method="POST" action="/anagrafiche/articoli">
        <div class="g2">
          <div class="fr"><label class="fl">Codice <span class="req">*</span></label><input type="text" name="codice" class="fi" required></div>
          <div class="fr"><label class="fl">GTIN-14</label><input type="text" name="gtin14" class="fi" maxlength="14" placeholder="14 cifre"></div>
        </div>
        <div class="fr"><label class="fl">Descrizione <span class="req">*</span></label><input type="text" name="descrizione" class="fi" required></div>
        <div class="fr"><label class="fl">Stato</label><select name="stato" class="fi"><option value="attivo">Attivo</option><option value="bozza">Bozza</option></select></div>
        <div class="btn-row"><button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i>Aggiungi</button></div>
      </form>
    </div>
  </div>
</div>

<script>
// Inizializza tab dal query param
document.addEventListener('DOMContentLoaded', () => {
  const params = new URLSearchParams(location.search)
  const t = params.get('tab') || 'fornitori'
  if (t !== 'fornitori') switchTab('ana', t)
})
</script>
